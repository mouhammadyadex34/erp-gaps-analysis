# Donnees brutes : non versionnees, mais integralement regenerables via
# `python src/scraper.py` (le script, lui, est versionne).
data/raw/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Sorties intermediaires de LaTeX. Le PDF, lui, est versionne : c'est le
# livrable que l'on partage, et le recompiler demande une chaine TeX.
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.bbl
paper/*.bcf
paper/*.blg
paper/*.run.xml

# Journaux de collecte (bruit, non reproductibles)
data/interim/*.log

# Sorties de nbconvert (les notebooks versionnes restent les sources)
notebooks/*.nbconvert.ipynb

# Le corpus nettoye n'est pas versionne : 9 Mo pour 12 000 lignes, donc
# ~70 Mo une fois la collecte complete. Il se regenere entierement avec
# notebooks/01_collecte.ipynb puis 02_nettoyage.ipynb.
data/processed/modules_clean.csv

# Les figures sont versionnees : elles sont produites sur le corpus complet
# et le document LaTeX les inclut.
